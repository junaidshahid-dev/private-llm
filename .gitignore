# Weights, checkpoints and adapters — never in git.
# A single checkpoint is larger than this entire repository.
models/
checkpoints/
*.safetensors
*.bin
*.pt
*.ckpt

# Local environment
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
*.egg-info/

# Hugging Face cache (32GB of weights lives here)
.cache/
hf_cache/

# Secrets. There should never be a key in this repo, but do not rely on that.
.env
*.key
*.pem
kaggle.json

# Data: raw and intermediate stay local; the SPLITS are committed because the
# dataset hash in every run manifest refers to them, and a manifest pointing at
# a file nobody else has is not reproducibility.
data/raw/
data/cleaned/
!data/train/train.jsonl
!data/validation/validation.jsonl
!data/test/test.jsonl
!data/processed/manifest.json

# Evaluation OUTPUT is per-run and stays local...
evaluation/results/*/
!evaluation/results/.gitkeep

# ...EXCEPT the base measurement, which is committed deliberately.
#
# Base scores depend only on (model revision, decode settings, benchmark hash). None of those
# change between experiments, so this is a constant that costs ~45 minutes of GPU time to
# reproduce. Kaggle wipes local storage when a session ends. Committing it means every future
# comparison has its baseline immediately, and a reviewer can see exactly what the untuned model
# scored rather than taking a delta on trust.
!evaluation/results/base/
!evaluation/results/base/results.json

# The security baseline is also a permanent reference — the number every future change must beat.
!evaluation/results/seccap_base_v1/
!evaluation/results/seccap_base_v1/results.json
!evaluation/results/seccap_base_v1/REPORT.md

# Comparison reports are small, and they are the actual findings.
!evaluation/results/compare_*.json

# OS noise
.DS_Store
Thumbs.db

# RAG index is a build artifact — regenerate from docs with rag/ingest.py
rag/index/

# security tool audit log is runtime data
mcp_layer/security_audit.log

# runtime memory data (local only, never committed) + the at-rest encryption key
memory/store_data.json
memory/.memory_key
